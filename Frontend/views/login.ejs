<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style/admin.css">
    <link rel="stylesheet" href="/style/style.css">
    <title>Login</title>
</head>

<body>
    <div class="banner">
            <div class="logo-college"><img
                    src="https://res.cloudinary.com/ds5pgunpl/image/upload/v1772880884/college_logo_w3lrjs.png"
                    alt="college-photo" class="college-logo">
            </div>
            <p class="title">जिला शिक्षा एवं प्रशिक्षण संस्थान गोविंदपुर (धनबाद)</p>
    </div>
    <div class="login">
        <form action="/login" method="post">
            <div class="login-card"><input type="text" name="admin" id="" placeholder="Enter ID"></div>
            <div class="login-card"><input type="password" name="password" id="" placeholder="Enter Password"></div>
            <div class="login-card"><button class="submit-btn">Login</button></div>
        </form>
    </div>
</body>

</html>